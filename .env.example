# OpenRouter (free models available — get key at openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Services
CV_SERVICE_URL=http://localhost:8002
API_SERVICE_URL=http://localhost:8001

# ML model path (auto-generated by ml_model/train.py)
ML_MODEL_PATH=ml_model/wellbeing_model.pkl

# Optional: Supabase (for persistent storage across server restarts)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_...
# SUPABASE_SERVICE_KEY=eyJ...
